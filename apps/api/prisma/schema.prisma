// Flat collaboration units: tenant is the boundary; kinds do not imply hierarchy.
model CollaborationGroup {
  id String @id @default(cuid())
  organizationId String @map("organization_id")
  name String
  kind String @default("TEAM")
  description String?
  archivedAt DateTime? @map("archived_at")
  createdAt DateTime @default(now()) @map("created_at")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members GroupMember[]
  grants ResourceGrant[]
  @@unique([organizationId, name])
  @@unique([id, organizationId])
  @@map("org_collaboration_group")
}

model GroupMember {
  id String @id @default(cuid())
  organizationId String @map("organization_id")
  groupId String @map("group_id")
  membershipId String @map("membership_id")
  role String @default("MEMBER")
  group CollaborationGroup @relation(fields: [groupId, organizationId], references: [id, organizationId], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId, organizationId], references: [id, organizationId], onDelete: Cascade)
  @@unique([groupId, membershipId])
  @@map("org_group_member")
}

// First resource adapter is Project; its tasks/files inherit access, no implicit hierarchy.
model ResourceGrant {
  id String @id @default(cuid())
  organizationId String @map("organization_id")
  groupId String @map("group_id")
  projectId String @map("project_id")
  access String @default("READ")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  group CollaborationGroup @relation(fields: [groupId, organizationId], references: [id, organizationId], onDelete: Cascade)
  project Project @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  @@unique([groupId, projectId])
  @@map("org_resource_grant")
}
