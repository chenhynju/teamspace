# 数据库
DATABASE_URL="postgresql://teamspace:teamspace_dev_pwd@127.0.0.1:5434/teamspace?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_ACCESS_EXPIRES_IN="7d"

# 应用
APP_PORT=3001
APP_URL="http://localhost:3001"
WEB_URL="http://localhost:3000"
NODE_ENV=development

# OAuth - Google (留空则不启用 Google 登录)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3001/api/v1/auth/oauth/google/callback"

# OAuth - GitHub (留空则不启用 GitHub 登录)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_CALLBACK_URL="http://localhost:3001/api/v1/auth/oauth/github/callback"

# Stripe (沙盒，留空则用内部模拟计费)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# 邮件 (开发态用 console 输出)
MAIL_FROM="no-reply@teamspace.local"
RESEND_API_KEY=""
